# =============================================================================
# OpenDocket Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- Database ---
POSTGRES_USER=opendocket
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=opendocket
DATABASE_URL=postgresql+asyncpg://opendocket:changeme_in_production@db:5432/opendocket

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- DocumentCloud (free for civic/journalism use) ---
# Sign up at https://accounts.muckrock.com/accounts/signup/
DOCUMENTCLOUD_USERNAME=
DOCUMENTCLOUD_PASSWORD=

# --- Reddit API (free, register at https://www.reddit.com/prefs/apps) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=OpenDocket/1.0

# --- YouTube Data API (free tier: 10,000 units/day) ---
# Get a key at https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- CourtListener (free, register at https://www.courtlistener.com/sign-in/) ---
COURTLISTENER_API_KEY=

# --- LLM API (for summarization and glossary auto-detect) ---
# Claude API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- ChangeDetection.io ---
CHANGEDETECTION_URL=http://changedetection:5000
CHANGEDETECTION_API_KEY=

# --- ArchiveBox ---
ARCHIVEBOX_URL=http://archivebox:8000

# --- App Settings ---
SECRET_KEY=changeme_generate_a_real_secret_key
ENVIRONMENT=development
LOG_LEVEL=INFO
ACTIVE_RELEASE=epstein-files
